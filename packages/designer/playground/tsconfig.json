{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // 플레이그라운드는 배포물이 아니라 확인용 화면이다. 발행본과 같은 픽스처를
    // 올려 "화면 = 발행본"을 눈으로 대 보려면 renderer 쪽 파일도 읽어야 한다.
    "rootDir": "../..",
    "noEmit": true,
    // 저장된 양식 파일을 그대로 편집기에 올려 보기 위해 JSON을 읽는다.
    "resolveJsonModule": true
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "./**/*.ts",
    "./vite-env.d.ts",
    "../../renderer/src/pdf/ServiceReportTestFixture.ts",
    "../../viewer/src/**/*.ts",
    "../../../apps/poc/service-report/template.json"
  ]
}
